{
  "name": "awesomegitai",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "contracts:check": "node scripts/check-contracts.ts",
    "contracts:generate": "node scripts/check-contracts.ts --write",
    "test": "scripts/cargo-local.sh build -p agai-host -p agai-mcp && scripts/cargo-local.sh test --workspace && pnpm --dir spikes/platform-probe test && pnpm --filter @agai/client test",
    "typecheck": "pnpm --filter @agai/client typecheck",
    "e2e": "pnpm --filter @agai/client e2e",
    "desktop:build": "scripts/desktop.sh build",
    "desktop:dev": "scripts/desktop.sh dev"
  },
  "type": "module",
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
