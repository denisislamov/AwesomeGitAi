{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AwesomeGitAi",
  "version": "0.1.0",
  "identifier": "dev.awesomegitai.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AwesomeGitAi",
        "width": 1440,
        "height": 960,
        "minWidth": 390,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "capabilities": [
        {
          "identifier": "main-menu-events",
          "windows": ["main"],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-unlisten"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": {
      "binaries/agai-host": "bin/agai-host",
      "binaries/agai-mcp": "bin/agai-mcp",
      "binaries/relations/": "bin/relations/"
    }
  }
}
